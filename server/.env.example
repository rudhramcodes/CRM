PORT=3000
NODE_ENV=production

# ---------- REQUIRED ----------
# Use your MongoDB Atlas URI, or a local Mongo URI. Put the REAL value in server/.env on the VPS.
#   Atlas : mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?appName=Cluster0
#   Local : mongodb://crmuser:STRONG_PASSWORD@127.0.0.1:27017/crm
# If using Atlas, whitelist the VPS IP (194.238.19.57) in Atlas Network Access.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?appName=Cluster0

# Generate each with:  openssl rand -hex 32
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Public URLs ----------
CORS_ORIGIN=https://rudhramgroup.com
CLIENT_URL=https://rudhramgroup.com
APP_URL=https://rudhramgroup.com

# ---------- First super-admin (auto-created on first boot) ----------
SEED_EMAIL=admin@rudhramgroup.com
SEED_PASSWORD=StrongAdminPassword123
SEED_NAME=Rudhram Admin

# ---------- Email (optional — code uses RESEND; SMTP_* unused by current code) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@rudhramgroup.com
RESEND_FROM_NAME=Rudhram
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------- File uploads (optional — Cloudinary used, NOT ImageKit) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Zoho Meeting / Cliq (optional) ----------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_NAME=Rudhram CRM
ZOHO_ORG_ID=
ZOHO_USER_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com/oauth/v2
ZOHO_MEETING_API=https://meeting.zoho.com/api/v2
ZOHO_OAUTH_CALLBACK_URL=
ZOHO_CLIQ_WEBHOOK_URL=
# ZOHO_CLIQ_WEBHOOK_SALES=
# ZOHO_CLIQ_WEBHOOK_PROJECTS=
# ZOHO_CLIQ_WEBHOOK_FINANCE=
# ZOHO_CLIQ_WEBHOOK_SUPPORT=
# ZOHO_CLIQ_WEBHOOK_MANAGEMENT=
# ZOHO_CLIQ_WEBHOOK_GENERAL=
